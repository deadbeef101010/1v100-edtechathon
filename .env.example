# Runtime mode: production, development, or test.
NODE_ENV=development
# Interface to bind; use 0.0.0.0 in containers.
HOST=127.0.0.1
# HTTP and Socket.IO listening port.
PORT=3000
# SQLite database file path. Its parent directory must already exist.
DATABASE_PATH=./data/game.db
# Base64url-encoded 32-byte player and session signing secret. No default.
PLAYER_TOKEN_SECRET=
# SHA-256 hex digest of the separate meta-administrator key. No default.
META_KEY_SHA256=
# Application logging threshold.
LOG_LEVEL=info
# Source revision included in operational metadata.
BUILD_SHA=development
# Optional externally visible absolute URL, such as https://game.example.org.
BASE_URL=

# For Docker Compose only: host port mapped to the container's port 8000.
APP_PORT=8000
# For Docker Compose only: image used by `docker compose pull`.
IMAGE=ghcr.io/deadbeef101010/1v100-edtechathon:v0.1.0

# Legacy aliases remain accepted for upgrades: DB_PATH, TOKEN_SECRET, META_KEY_HASH.
